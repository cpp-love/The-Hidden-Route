{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "关卡数据样式",
    "description": "此格式为关卡数据的样式，用于存储关卡。",
    "type": "object",
    "properties": {
        "segments": {
            "title": "迷宫路径中的一段路径",
            "description": "这些路径将用来操控玩家行走。",
            "type": "array",
            "items": {
                "title": "迷宫路径中直的一段",
                "type": "object",
                "properties": {
                    "prev": {
                        "title": "路径（起始位置）连接的前面一个路径实体",
                        "description": "应填写列表的索引（从 0 开始计数），且不应超过列表的最大索引；若没有，填写 null。",
                        "oneOf": [
                            {
                                "type": "integer",
                                "minimum": 0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null
                    },
                    "next": {
                        "title": "路径（终止位置）连接的后面一个路径实体",
                        "description": "应填写列表的索引（从 0 开始计数），且不应超过列表的最大索引；若没有，填写 null。",
                        "oneOf": [
                            {
                                "type": "integer",
                                "minimum": 0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null
                    },
                    "start_center": {
                        "title": "路径起始位置的中心点",
                        "$ref": "types.schema.json#/$defs/vector2f"
                    },
                    "length": {
                        "title": "路径段的长度",
                        "type": "number",
                        "minimum": 0.0
                    },
                    "dir": {
                        "title": "线段的方向",
                        "description": "从起始位置到终止位置的方向。",
                        "type": "string",
                        "enum": [
                            "right",
                            "down",
                            "left",
                            "up"
                        ]
                    },
                    "layer": {
                        "title": "这个段的所属的层级编号",
                        "description": "层级编号越小就代表显示在越前面。",
                        "type": "integer",
                        "minimum": 0,
                        "default": 0
                    },
                    "tags": {
                        "title": "路径段的标签",
                        "description": "用于标记路径段的标签列表。",
                        "type": "array",
                        "items": {
                            "title": "一个标签",
                            "type": "integer"
                        },
                        "default": []
                    },
                    "outline": {
                        "title": "这一段路径的轮廓",
                        "description": "只是一些装饰性的折线，不起其他作用。",
                        "type": "object",
                        "properties": {
                            "color": {
                                "title": "轮廓颜色",
                                "$ref": "types.schema.json#/$defs/color"
                            },
                            "vertexs": {
                                "title": "轮廓的所有折线的点集",
                                "type": "array",
                                "items": {
                                    "title": "一条折线的点集",
                                    "type": "array",
                                    "items": {
                                        "title": "一个点",
                                        "$ref": "types.schema.json#/$defs/vector2f"
                                    },
                                    "minItems": 1
                                },
                                "default": []
                            }
                        },
                        "default": {}
                    }
                },
                "required": [
                    "start_center",
                    "length",
                    "dir"
                ]
            },
            "minItems": 1
        },
        "level_script": {
            "title": "关卡对应的脚本",
            "description": "关卡脚本的文件名（相对于 `assets/lua_scripts/` 目录），若没有则为 null。",
            "type": [
                "string",
                "null"
            ],
            "default": null
        },
        "player_infos": {
            "title": "玩家信息",
            "type": "array",
            "items": {
                "title": "每一个玩家的信息",
                "type": "object",
                "properties": {
                    "color": {
                        "title": "玩家颜色",
                        "$ref": "types.schema.json#/$defs/color"
                    },
                    "start_segment_entity": {
                        "title": "起始段落对应的实体",
                        "description": "应填写段落列表的索引（从 0 开始计数），且不应超过列表的最大索引；若没有，填写 null。",
                        "type": "integer",
                        "minimum": 0
                    },
                    "end_segment_entity": {
                        "title": "结束段落对应的实体",
                        "description": "应填写段落列表的索引（从 0 开始计数），且不应超过列表的最大索引；若没有，填写 null。",
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "required": [
                    "start_segment_entity",
                    "end_segment_entity",
                    "color"
                ]
            }
        }
    },
    "required": [
        "player_infos",
        "segments"
    ]
}